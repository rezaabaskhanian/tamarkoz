# Add project specific ProGuard rules here.
# By default, the flags in this file are appended to flags specified
# in /usr/local/Cellar/android-sdk/24.3.3/tools/proguard/proguard-android.txt
# You can edit the include path and order by changing the proguardFiles
# directive in build.gradle.
#
# For more details, see
#   http://developer.android.com/guide/developing/tools/proguard.html

# Add any project specific keep options here:

# --- Tamarkoz (R8 is on for release builds) ---

# TurboModule specs generated by codegen and our native modules (looked up by name).
-keep class com.tamarkoz.specs.** { *; }
-keep class com.tamarkoz.focus.** { *; }

# op-sqlite: its C++ side calls back into these classes over JNI.
-keep class com.op.sqlite.** { *; }

# Cafe Bazaar billing (Poolakey) talks to Bazaar through AIDL/intents.
-keep class ir.cafebazaar.poolakey.** { *; }
-keep class com.android.vending.billing.** { *; }
-dontwarn ir.cafebazaar.poolakey.**
